From 44a564a91dc5a3ec127975c31b1001ba89d2485e Mon Sep 17 00:00:00 2001
From: Christopher Oezbek <c.oezbek@gmail.com>
Date: Tue, 3 Nov 2026 22:49:23 +0100
Subject: [PATCH] Add win32_software_renderer option to render with WARP

---
 grey/app.h                       | 7 +++++++
 grey/backends/win32_dx11_app.hpp | 8 ++++----
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/grey/app.h b/grey/app.h
index a7ab3f4..c9443bf 100644
--- a/grey/app.h
+++ b/grey/app.h
@@ -181,6 +181,13 @@ namespace grey {
          */
         bool win32_close_on_focus_lost{false};
 
+        /**
+         * @brief Render with Direct3D's WARP software rasterizer instead of the GPU. Creating a hardware device loads
+         * the graphics driver into the process, which can take ~100 ms; WARP starts in ~15 ms. Useful for small,
+         * short-lived windows. Needs to be set before application starts up to take effect.
+         */
+        bool win32_software_renderer{false};
+
 
         /**
          * @brief When set to true, a window can be grabbed and moved by dragging inside any area of the window.
diff --git a/grey/backends/win32_dx11_app.hpp b/grey/backends/win32_dx11_app.hpp
index f3448d4..3cc47c4 100644
--- a/grey/backends/win32_dx11_app.hpp
+++ b/grey/backends/win32_dx11_app.hpp
@@ -53,7 +53,7 @@ namespace grey::backends {
     static ID3D11RenderTargetView *g_mainRenderTargetView = nullptr;
 
     // Forward declarations of helper functions
-    bool CreateDeviceD3D(HWND hWnd);
+    bool CreateDeviceD3D(HWND hWnd, bool prefer_warp = false);
 
     void CleanupDeviceD3D();
 
@@ -64,7 +64,7 @@ namespace grey::backends {
     LRESULT WINAPI WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam);
 
     // Helper functions
-    bool CreateDeviceD3D(HWND hWnd) {
+    bool CreateDeviceD3D(HWND hWnd, bool prefer_warp) {
         // Setup swap chain
         DXGI_SWAP_CHAIN_DESC sd;
         ZeroMemory(&sd, sizeof(sd));
@@ -86,7 +86,7 @@ namespace grey::backends {
         //createDeviceFlags |= D3D11_CREATE_DEVICE_DEBUG;
         D3D_FEATURE_LEVEL featureLevel;
         const D3D_FEATURE_LEVEL featureLevelArray[2] = {D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_0,};
-        HRESULT res = D3D11CreateDeviceAndSwapChain(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, createDeviceFlags,
+        HRESULT res = D3D11CreateDeviceAndSwapChain(nullptr, prefer_warp ? D3D_DRIVER_TYPE_WARP : D3D_DRIVER_TYPE_HARDWARE, nullptr, createDeviceFlags,
                                                     featureLevelArray, 2, D3D11_SDK_VERSION, &sd, &g_pSwapChain,
                                                     &g_pd3dDevice, &featureLevel, &g_pd3dDeviceContext);
         if(res == DXGI_ERROR_UNSUPPORTED) // Try high-performance WARP software driver if hardware is not available.
@@ -503,7 +503,7 @@ namespace grey::backends {
             }
 
             // Initialize Direct3D
-            if(!CreateDeviceD3D(hWnd)) {
+            if(!CreateDeviceD3D(hWnd, win32_software_renderer)) {
                 CleanupDeviceD3D();
                 ::UnregisterClassW(wc.lpszClassName, wc.hInstance);
                 return;
-- 
2.53.0

